# Flowlight's daemon, shipped disabled.
#
# A tool that reads every HTTPS request on a machine must not start doing it because somebody installed it, so
# nothing here is enabled by the package. `systemctl enable --now flowlightd` is a decision somebody makes.
[Unit]
Description=Flowlight: what every process on this machine says on the network
Documentation=https://github.com/xinbetween/flowlight-linux
After=network.target

[Service]
Type=simple
# Root, because loading an eBPF program needs it. There is no version of this that does not.
#
# **If you want the window**, say who it belongs to:
#
#     ExecStart=/usr/sbin/flowlightd --socket-owner your-name
#
# The window runs as a person and the daemon runs as root, and they meet at a socket with an owner and a
# mode — which is the whole reason it is a socket and not a port with a token. Started by hand with `sudo`
# the owner is obvious; started here there is nobody to infer, so the socket belongs to root with mode 0600
# and a person's window is refused by the kernel. `systemctl edit flowlightd` is the place to add it.
ExecStart=/usr/sbin/flowlightd
Restart=on-failure
RestartSec=5

# The database and the interception keys live here, and it is root's alone.
StateDirectory=flowlight
StateDirectoryMode=0700
# The certificate anything must trust is published here instead, because an agent runs as a person. This is
# also the only directory under `/etc` or `/usr` the service can write to, `ProtectSystem=full` making the rest
# read-only — which is why the daemon's default certificate path is this one and not `/usr/local/share`.
ConfigurationDirectory=flowlight
ConfigurationDirectoryMode=0755

# It needs to load programs, read /proc and attach to a cgroup. It does not need anything else.
NoNewPrivileges=false
ProtectHome=read-only
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
